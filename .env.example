# Copie para .env, gere o segredo e carregue no shell (veja README).
# Este arquivo usa sintaxe de shell; Django não lê .env automaticamente.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=America/Fortaleza
# Omitir para usar var/library.sqlite3. Se definido, usar caminho absoluto local.
LIBRARY_DATABASE_PATH=
# Reservado à futura integração; nenhuma chamada externa existe nesta etapa.
MUSICBRAINZ_CONTACT=
